# 敏感配置（API key）
.env
.claude
# 构建产物
.task/
*.exe
dist
bin/
release/

# 系统垃圾
*.stackdump

# 前端
frontend/node_modules/
frontend/dist/
node_modules

# 运行时数据（会话存档/话题索引/设置/记忆/MCP 配置）
sessions/
topics.json
settings.json
memory.md
mcp.json
skills/

# 桌面应用形态：本地应用配置 + 数据目录
ezharness.json
data/

# IDE
.idea/
.vscode/

# 内建技能的嵌入资源是源码（上面的 skills/ 规则只针对运行时用户技能目录）
!core/internal/builtinskill/skills/
!core/internal/builtinskill/skills/**

# 运行时记忆目录（cwd=包目录跑测试时的残留）
core/internal/hooks/memory/

# Trae 工具的分享打包产物
.trae-html-share-packages/
